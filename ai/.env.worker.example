# Copy to `.env`, then run the worker overlay (see docker-compose.worker.yml).
# Both values come from the app's "Activate AI on my PC" screen.

# The hosted verdure back (HTTPS), e.g. https://verdure.example.com
VERDURE_BACK_URL=

# Your personal worker token (starts with vwk_). Shown once when you create it.
VERDURE_WORKER_TOKEN=

# Copy to `.env`, then run the worker overlay (see docker-compose.worker.yml).

# The hosted verdure back (HTTPS), e.g. https://verdure.example.com
VERDURE_BACK_URL=

# Optional: a pre-set worker token (starts with vwk_). Leave it empty for the
# hands-free flow — the worker opens a page for you to confirm the connection on
# first launch, then remembers it. Only set this for headless setups or tests.
VERDURE_WORKER_TOKEN=

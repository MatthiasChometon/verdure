PORT=3666
# GraphQL endpoint, reached from three vantage points. They only diverge under
# Docker (SSR/codegen run inside the container, the browser hits the published
# port); locally the last two fall back to GQL_HOST.
GQL_HOST=http://localhost:3000/graphql
# GQL_INTROSPECTION_HOST=http://back:3000/graphql   # codegen (Docker)
# GQL_CLIENT_HOST=http://localhost:3000/graphql     # browser (Docker)
NUXT_PUBLIC_API_BASE=http://localhost:3000
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3666

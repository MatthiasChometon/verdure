{
  "name": "front",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Front verdure — Nuxt/Vue, liste des plantes",
  "author": "Matthias Chometon <matthiaschometon787@gmail.com>",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "nuxt build && playwright test visual.test",
    "test:perf": "nuxt build && playwright test perf.test --project=mobile",
    "test:visual:update": "nuxt build && playwright test --update-snapshots",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/ui": "^4.13.1",
    "@nuxtjs/i18n": "^10.7.0",
    "graphql-request": "^7.4.0",
    "nuxt": "^4.7.0",
    "nuxt-graphql-client": "^0.2.46",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.160",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/vue": "^8.1.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.6.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "happy-dom": "^20.14.6",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  }
}

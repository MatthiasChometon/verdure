PORT=3000
DATABASE_URL=postgres://verdure:verdure@localhost:5432/verdure
# Image storage. Default driver `disk` needs no bucket and no external account —
# it writes under STORAGE_DIR (defaults to ./storage). On shared hosting point
# STORAGE_DIR OUTSIDE the app dir so a redeploy does not wipe the images.
# `s3` opts into the S3/MinIO driver below (the local docker-compose runs MinIO).
STORAGE_DRIVER=s3
STORAGE_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=plants
S3_ACCESS_KEY=verdure
S3_SECRET_KEY=verdure-secret
S3_FORCE_PATH_STYLE=true
FRONT_URL=http://localhost:3666
JWT_SECRET=dev-jwt-secret-change-in-prod
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Mail — dev default: Mailpit (docker), read the inbox at http://localhost:8025.
# Alt dev: MAIL_HOST=ethereal (Nodemailer test account, preview URL in the logs).
# Prod: Gmail SMTP → MAIL_HOST=smtp.gmail.com, MAIL_PORT=465, MAIL_SECURE=true,
# MAIL_USER=<gmail address>, MAIL_PASS=<app password>.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=verdure <noreply@verdure.local>
# AI — the verdure-ai bundle (ComfyUI) exposes plant identification + text
# embeddings. Run it from the verdure-ai repo: `docker compose up`.
AI_API_URL=http://localhost:8000
VISION_URL=http://localhost:8000
# Pl@ntNet API key (my.plantnet.org — free tier ~500 identifications/day). The
# DEFAULT recogniser: used whenever the user has no local AI worker online, so
# plant recognition works for everyone with no GPU and no install. The key is
# used server-side only (never exposed to the browser). Empty = worker-only.
PLANTNET_API_KEY=

# Comma-separated emails allowed to read bug reports. Empty = nobody is admin.
ADMIN_EMAILS=

# Web Push (VAPID) — watering reminders. Generate a keypair once with
# `pnpm dlx web-push generate-vapid-keys` (or `node -e "console.log(require('web-push').generateVAPIDKeys())"`).
# VAPID_SUBJECT is a mailto: or https: contact for the push service. Leave the
# keys empty to disable push reminders: the subscribe mutation refuses, the
# webPushPublicKey query returns null (the front hides the toggle) and the
# reminder scheduler skips sending. Both keys are required together.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@verdure.local

# Watering reminder scheduler. The cron fires once a day at REMINDER_HOUR
# (0–23) in REMINDER_TIMEZONE and pushes each user the plants due that day.
# Set REMINDER_ENABLED=false to keep the job wired but idle (e.g. on a second
# checkout sharing the dev database).
REMINDER_ENABLED=true
REMINDER_HOUR=8
REMINDER_TIMEZONE=Europe/Paris

# Comma-separated list of origins allowed to call the API with credentials.
# Leave unset in dev (localhost fronts are allowed); a deployment MUST set it
# to the front origin, e.g. https://verdure.mtxlab.xyz
ALLOWED_ORIGINS=
# GraphQL introspection. Off by default (the schema is a map of the attack
# surface). Set to true only where the front needs to introspect this API
# to generate its types (local dev / a build-time instance), never in prod.
GRAPHQL_INTROSPECTION=false

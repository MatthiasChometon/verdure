{
  "name": "back",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:emails": "vite build --config vite.emails.config.ts",
    "build": "pnpm build:emails && nest build",
    "format": "prettier --write \"{domain,infrastructure}/**/*.ts\" \"main.ts\" \"app.module.ts\" \"drizzle.config.ts\"",
    "format:check": "prettier --check \"{domain,infrastructure}/**/*.ts\" \"main.ts\" \"app.module.ts\" \"drizzle.config.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed-species": "ts-node --transpile-only domain/species/seeder.ts",
    "db:seed-nicknames": "ts-node --transpile-only domain/nickname/seeder.ts",
    "db:studio": "drizzle-kit studio",
    "start": "pnpm build:emails && nest start",
    "start:dev": "pnpm build:emails && nest start --watch",
    "start:debug": "pnpm build:emails && nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{domain,infrastructure}/**/*.ts\" \"main.ts\" \"app.module.ts\" \"drizzle.config.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk",
    "test:e2e": "pnpm build:emails && vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/fastify": "^3.1.0",
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/s3-request-presigner": "^3.1092.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.0",
    "@nestjs/apollo": "^13.4.2",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/graphql": "^13.4.2",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.28",
    "@vue/server-renderer": "^3.5.40",
    "axios": "^1.18.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "graphql": "^16.14.2",
    "html-to-text": "^10.0.0",
    "nest-commander": "^3.20.1",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^17.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.9",
    "vite": "^8.1.5",
    "vitest": "^4.1.9"
  }
}

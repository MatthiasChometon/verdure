{
  "name": "back",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:emails": "vite build --config vite.emails.config.ts",
    "build": "pnpm build:emails && nest build",
    "format": "prettier --write \"{domain,infrastructure}/**/*.ts\" \"main.ts\" \"app.module.ts\" \"drizzle.config.ts\"",
    "format:check": "prettier --check \"{domain,infrastructure}/**/*.ts\" \"main.ts\" \"app.module.ts\" \"drizzle.config.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "schema:generate": "ts-node --transpile-only infrastructure/graphql/generate-schema.ts",
    "db:seed-species": "ts-node --transpile-only domain/species/seeder.ts",
    "db:seed-nicknames": "ts-node --transpile-only domain/nickname/seeder.ts",
    "db:studio": "drizzle-kit studio",
    "start": "pnpm build:emails && nest start",
    "start:dev": "pnpm build:emails && nest start --watch",
    "start:debug": "pnpm build:emails && nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{domain,infrastructure}/**/*.ts\" \"main.ts\" \"app.module.ts\" \"drizzle.config.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk",
    "test:e2e": "pnpm build:emails && vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.2",
    "@as-integrations/fastify": "^3.1.0",
    "@aws-sdk/client-s3": "^3.1178.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@nestjs/apollo": "^13.4.5",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.2.12",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.12",
    "@nestjs/graphql": "^13.4.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.2.12",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.8.0",
    "@vue/server-renderer": "^3.5.46",
    "axios": "^1.21.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cron": "4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "graphql": "^16.15.0",
    "html-to-text": "^10.0.1",
    "nest-commander": "^3.21.0",
    "nodemailer": "^10.6.1",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "vue": "^3.5.46",
    "vue-i18n": "^11.4.24",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.12",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.19.4",
    "@types/nodemailer": "^8.0.2",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "unplugin-swc": "^1.6.0",
    "vite": "^8.4.0",
    "vitest": "^4.1.12"
  }
}

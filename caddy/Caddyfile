# One HTTPS origin for the whole app. Caddy gets a Let's Encrypt certificate
# automatically for $DOMAIN (which must resolve to this server, ports 80+443
# open). The back's routes are proxied to `back`, everything else to `front`,
# so front and back share the same origin — simple cookies, working Google
# login, no CORS. The AI, DB and storage stay off the public network entirely.
{$DOMAIN} {
	handle /graphql* {
		reverse_proxy back:3000
	}
	handle /auth/* {
		reverse_proxy back:3000
	}
	handle /uploads/* {
		reverse_proxy back:3000
	}
	handle /images/* {
		reverse_proxy back:3000
	}
	handle {
		reverse_proxy front:3000
	}
}

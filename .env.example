# Optional overrides for the full-stack compose. Everything has a working dev
# default, so copying this file is only needed to enable Google login or set a
# real JWT secret. `docker compose` reads a file named `.env` automatically.

# Public domain for the prod deployment (Caddy gets a Let's Encrypt cert for it,
# and it must point to the server with ports 80+443 open). Prod compose only.
DOMAIN=verdure.example.com

# Google OAuth (leave empty to disable the "Sign in with Google" button).
# In prod, register https://<DOMAIN>/auth/google/callback in Google Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signing secret for the auth cookie (change it for anything public)
JWT_SECRET=dev-jwt-secret-change-in-prod

# Production email (prod compose only) — Gmail SMTP. MAIL_USER is your Gmail
# address; MAIL_PASS is a Google "app password" (Account → Security → 2-Step
# Verification → App passwords), NOT your login password. In dev, mail is caught
# by Mailpit and these are ignored.
MAIL_USER=
MAIL_PASS=
MAIL_FROM=verdure <your.address@gmail.com>

# Host the browser uses to reach the back / storage. Leave as localhost for
# desktop use; set it to your machine's LAN IP (e.g. 192.168.1.12) to open the
# app from a phone on the same network — http://<LAN-IP>:3666.
# (Google login won't work over a raw IP; email/password does.)
PUBLIC_HOST=localhost
